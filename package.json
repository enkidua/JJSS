{
    "name": "jjss",
    "private": true,
    "version": "3.2.0",
    "description": "직업재활업무시스템(JJSS) 데스크톱 앱",
    "author": "Antigravity",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check:release": "node scripts/check-release-readiness.cjs",
        "test:rehab-plan-mapper": "node scripts/test-rehab-plan-mapper.mjs",
        "test:rehab-workflow": "node scripts/test-rehab-workflow.mjs",
        "test:file-service": "node scripts/test-jjss-file-service.cjs",
        "test:runtime-safety": "node scripts/test-runtime-safety.mjs",
        "test:ai-settings": "node scripts/test-ai-settings.mjs",
        "test:ai-safety": "node scripts/test-ai-request-safety.mjs",
        "test:ai-api": "node scripts/test-ai-api-contracts.mjs",
        "test:anonymizer": "node scripts/test-anonymizer.mjs",
        "test:privacy-outbound": "node scripts/test-privacy-outbound.mjs",
        "test:crypto": "node scripts/test-crypto-backup.mjs",
        "test:usability": "node scripts/test-usability.cjs",
        "test:budget-calc": "node scripts/test-budget-calc.mjs",
        "test:supported-employment": "node scripts/test-supported-employment.mjs",
        "test:secure-key": "node scripts/test-secure-key.mjs",
        "test:at-rest-migration": "node scripts/test-at-rest-migration.mjs",
        "test:data-at-rest": "node scripts/test-data-at-rest.cjs",
        "test:electron-pdfjs": "electron scripts/test-electron-pdfjs.cjs",
        "test:all": "npm run typecheck && npm run test:rehab-plan-mapper && npm run test:rehab-workflow && npm run test:file-service && npm run test:updater && npm run test:google-drive && npm run test:folder-drive && npm run test:shared-drive && npm run test:runtime-safety && npm run test:ai-settings && npm run test:api-key-format && npm run test:ai-safety && npm run test:ai-api && npm run test:anonymizer && npm run test:privacy-outbound && npm run test:crypto && npm run test:budget-calc && npm run test:supported-employment && npm run test:ve-workbench && npm run test:ve-storage && npm run test:secure-key && npm run test:at-rest-migration && npm run check:release",
        "electron:dev": "vite build && electron .",
        "electron:build": "vite build && electron-builder --publish never --win --x64",
        "electron:build:win:signed": "node scripts/check-release-readiness.cjs && node scripts/check-win-signing.cjs && vite build && electron-builder --publish never --win --x64",
        "electron:build:mac": "vite build && electron-builder --publish never --mac --arm64 --config.afterPack=./scripts/sign-mac-adhoc.cjs",
        "electron:build:mac-m1": "npm run electron:build:mac",
        "test:ve-workbench": "node scripts/test-ve-workbench.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "make:ve-verification": "node scripts/make-ve-verification.mjs",
        "make:verification": "node scripts/make-jjss-verification.mjs",
        "verify:ai-live": "node scripts/verify-ai-live.mjs",
        "check:build": "node scripts/check-production-build.mjs",
        "verify:release": "npm run test:all && npm run test:data-at-rest && npm run build && npm run check:build && npm run test:electron-pdfjs && npm run test:usability",
        "test:ve-storage": "node scripts/test-ve-storage.mjs",
        "test:api-key-format": "node scripts/test-api-key-format.mjs",
        "test:updater": "node scripts/test-updater.cjs",
        "test:google-drive": "node scripts/test-google-drive.cjs",
        "test:shared-drive": "node scripts/test-shared-drive.mjs",
        "test:folder-drive": "node scripts/test-folder-drive.cjs"
    },
    "build": {
        "appId": "com.jjss.desktop",
        "productName": "JJSS",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "asar": true,
        "publish": {
            "provider": "github",
            "owner": "enkidua",
            "repo": "JJSS",
            "releaseType": "release"
        },
        "win": {
            "executableName": "JJSS-Pro",
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "signtoolOptions": {
                "publisherName": [
                    "JJSS"
                ]
            },
            "verifyUpdateCodeSignature": true
        },
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "icon": "build/icon.png",
            "hardenedRuntime": false,
            "gatekeeperAssess": false
        },
        "dmg": {
            "title": "JJSS",
            "format": "UDZO",
            "contents": [
                {
                    "x": 410,
                    "y": 150,
                    "type": "link",
                    "path": "/Applications"
                },
                {
                    "x": 130,
                    "y": 150,
                    "type": "file"
                }
            ],
            "artifactName": "JJSS-${version}-arm64.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "include": "electron/jjss-installer.nsh",
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "JJSS",
            "uninstallDisplayName": "JJSS",
            "deleteAppDataOnUninstall": false,
            "createStartMenuShortcut": true,
            "artifactName": "JJSS-Setup-${version}.${ext}"
        }
    },
    "devDependencies": {
        "@fontsource-variable/noto-sans-kr": "^5.3.0",
        "@google/genai": "^1.0.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "docx": "^9.6.1",
        "electron": "^44.5.1",
        "electron-builder": "^26.17.0",
        "file-saver": "^2.0.5",
        "framer-motion": "^11.0.0",
        "html2canvas": "^1.4.1",
        "jszip": "^3.10.1",
        "lucide-react": "^0.460.0",
        "pdfjs-dist": "^6.3.289",
        "playwright": "^1.63.0",
        "postcss": "^8.4.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-router-dom": "^7.18.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.6.0",
        "vite": "^6.0.0",
        "zustand": "^5.0.0"
    },
    "browserslist": [
        "last 2 Chrome versions"
    ],
    "dependencies": {
        "electron-updater": "^6.8.11"
    }
}
